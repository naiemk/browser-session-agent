# VPS API — Pi SDK + chat WebSocket. No Chromium.
# Do not set BSA_NO_PI in this image; production must run createAgentSession.
# Keep this file in lockstep with deploy/docker/Dockerfile.api.
FROM node:22-bookworm-slim
WORKDIR /app

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PI_OFFLINE=1
ENV PORT=8787
ENV BSA_HOME=/data
ENV BSA_AGENT_DIR=/data/pi-agent
ENV BSA_SESSION_DIR=/data/sessions

# Playwright's npm package stays (API imports parseStartArgs from session.ts).
# Browsers are not downloaded; Chromium does not run in this image.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
  && npm install --save-prod tsx@4.23.13 \
  && mkdir -p /data/pi-agent /data/sessions

ENV NODE_ENV=production

COPY src ./src
COPY bin ./bin
COPY deploy/pi-meter.json ./pi-meter.json

EXPOSE 8787
VOLUME ["/data"]
HEALTHCHECK --interval=20s --timeout=5s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "--import", "tsx", "src/hosts/web/cli.ts"]
