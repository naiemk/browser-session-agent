FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm install tsx
COPY src ./src
COPY bin ./bin
COPY deploy/pi-meter.json ./pi-meter.json
ENV PORT=8787
ENV NODE_ENV=production
EXPOSE 8787
# Intentionally no playwright / chromium.
CMD ["node", "--import", "tsx", "src/hosts/web/cli.ts"]
