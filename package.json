{
  "name": "magpie-agent",
  "version": "0.1.2",
  "description": "Pi-powered persistent browser operator with bounded Playwright tools",
  "type": "module",
  "keywords": [
    "magpie",
    "pi-package",
    "playwright",
    "browser-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiemk/browser-session-agent.git"
  },
  "homepage": "https://github.com/naiemk/browser-session-agent#readme",
  "bugs": {
    "url": "https://github.com/naiemk/browser-session-agent/issues"
  },
  "main": "./src/index.ts",
  "bin": {
    "magpie": "./bin/bsa-cli.mjs",
    "browser-agent": "./bin/browser-agent.mjs",
    "bsa": "./bin/bsa-cli.mjs",
    "browser-session-cli": "./bin/bsa-cli.mjs",
    "browser-session-web": "./bin/bsa-web.mjs",
    "browser-session-api": "./bin/browser-session-api.mjs",
    "browser-session-node": "./bin/browser-session-node.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "browser-skills",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 --test-timeout=120000 tests/unit/*.test.ts tests/integration/*.test.ts tests/e2e/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 --test-timeout=120000 tests/e2e/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "precommit": "npm run typecheck && npm test && npm run suite:reference && npm run suite",
    "agent": "tsx src/cli/run.ts",
    "suite": "tsx src/cli/run.ts suite --target mock",
    "suite:reference": "tsx src/cli/run.ts suite --target reference",
    "suite:live": "tsx src/cli/run.ts suite --target live",
    "optimize:baseline": "tsx src/cli/run.ts suite --target mock --all --optimize-out optimize/baseline.json",
    "optimize:check": "tsx src/cli/run.ts suite --target mock --all --optimize-out /tmp/optimize-current.json && tsx src/cli/run.ts compare optimize/baseline.json /tmp/optimize-current.json",
    "e2e:jsonlint": "tsx scripts/e2e-jsonlint.ts",
    "cli": "node bin/bsa-cli.mjs",
    "web": "node bin/bsa-web.mjs",
    "dev": "node bin/bsa-cli.mjs",
    "start:api": "tsx src/hosts/web/cli.ts",
    "start:node": "tsx src/hosts/node-agent/cli.ts",
    "helper:pack": "node scripts/pack-helper.mjs",
    "docker:local": "docker compose -f deploy/docker/compose.local.yml up --build",
    "docker:vps": "docker compose -f deploy/docker/compose.vps.yml up -d",
    "docker:node": "docker compose -f deploy/docker/compose.node.yml up -d"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@mariozechner/pi-web-ui": "^0.73.1",
    "pi-meter": "^0.1.1",
    "pi-model-auto": "^0.2.2",
    "playwright": "^1.55.0",
    "tsx": "^4.23.13",
    "typebox": "^1.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  }
}
