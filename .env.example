# Shared by the VPS API and the desktop node.
# BSA_TOKEN is an operator escape hatch, not required for the Docker helper.
BSA_TOKEN=change-me

# VPS (deploy/docker/compose.vps.yml) — Pre-V1 host is agent.trustless-commerce.com
BSA_HTTP_PORT=8080
BSA_HOST=agent.trustless-commerce.com
# Close public signup after the personal account exists:
# BSA_REGISTER_OPEN=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# Desktop node (deploy/docker/compose.node.yml)
# If the API is on this machine: ws://host.docker.internal:8787/node
# If the API is on a VPS:        wss://agent.trustless-commerce.com/node
BSA_API_URL=wss://agent.trustless-commerce.com/node
BSA_HEADLESS=1
# BSA_PAIR_CODE=  # one-time pair; curl -fsSL https://agent.trustless-commerce.com/install.sh | bash
# BSA_DATA=$HOME/.browser-session-agent
