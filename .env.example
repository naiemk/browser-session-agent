# Shared by the VPS API and the desktop node.
BSA_TOKEN=change-me

# VPS (deploy/docker/compose.vps.yml)
BSA_HTTP_PORT=8080
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# Desktop node (deploy/docker/compose.node.yml)
# If the API is on this machine: ws://host.docker.internal:8787/node
# If the API is on a VPS:        wss://api.example.com/node
BSA_API_URL=wss://api.example.com/node
BSA_HEADLESS=1
# BSA_DATA=$HOME/.browser-session-agent
